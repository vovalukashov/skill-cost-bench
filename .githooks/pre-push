#!/bin/sh
# Refuse to push anything derived from a private repository.
# Enable with: git config core.hooksPath .githooks
#
# Fails closed: if no interpreter here can run the guard, the push is refused
# rather than allowed. A guard that gives up quietly is not a guard.
root="$(git rev-parse --show-toplevel)" || exit 1

for py in "$root/.venv/bin/python" python3 python; do
    if "$py" -c 'import yaml' >/dev/null 2>&1; then
        exec "$py" "$root/scripts/check_publish.py" --quiet
    fi
done

echo "pre-push: no Python with PyYAML available to run scripts/check_publish.py." >&2
echo "          Refusing the push. Install PyYAML, or create the venv:" >&2
echo "            python3 -m venv .venv && .venv/bin/pip install pyyaml pytest" >&2
exit 1
